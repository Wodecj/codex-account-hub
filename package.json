{
  "name": "codex-account-hub",
  "version": "0.1.2",
  "description": "Windows Codex CLI profile launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.example.codexaccounthub",
    "productName": "Codex Account Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "package.json",
      "quota.js",
      "tray.png",
      "update-source.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Wodecj",
        "repo": "codex-account-hub"
      }
    ],
    "artifactName": "Codex-Account-Hub-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
